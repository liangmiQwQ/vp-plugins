{
  "name": "vp-plugin-react",
  "version": "0.0.0",
  "description": "React support for Vite+ in a single plugin.",
  "homepage": "https://github.com/liangmiQwQ/vp-plugin#readme",
  "bugs": {
    "url": "https://github.com/liangmiQwQ/vp-plugin/issues"
  },
  "license": "MIT",
  "author": "Liang Mi <hi@liangmi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangmiQwQ/vp-plugin.git",
    "directory": "examples/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run cpack",
    "check": "vp run ccheck",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:react",
    "vite-plus": "catalog:",
    "vp-plugin-kit": "workspace:*"
  },
  "peerDependencies": {
    "vite-plus": ">=1.0.0"
  }
}
